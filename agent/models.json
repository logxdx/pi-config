{
    "$schema": "https://pi.dev/schemas/models.schema.json",
    "providers": {
        "llamacpp": {
            "baseUrl": "http://127.0.0.1:11434/v1",
            "api": "openai-completions",
            "apiKey": "local",
            "models": [
                {
                    "id": "ling3",
                    "name": "Ling 3.0 Tiny Q5_K_M",
                    "reasoning": true,
                    "input": [
                        "text"
                    ],
                    "contextWindow": 128000,
                    "maxTokens": 32768,
                    "cost": {
