{
  "lastChangelogVersion": "1.2.0",
  "terminal": {
    "showImages": false,
    "imageWidthCells": 60,
    "showTerminalProgress": true
  },
  "images": {
    "blockImages": true
  },
  "transport": "auto",
  "httpIdleTimeoutMs": 300000,
  "cacheWarming": "streaming",
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "enableInstallTelemetry": false,
  "tuiMode": "fullscreen",
  "theme": "dark",
  "hideThinkingBlock": true,
  "packages": [
    "./packages/pi-interactive-subagents",
    "./packages/pi-observational-memory"
  ],
  "compaction": {
    "modelOverrides": {
      "llama.cpp/ling3": {
        "reserveTokens": 32768
      },
      "llama.cpp/ling3-expq4k": {
        "reserveTokens": 32768
      },
      "llama.cpp/qwen3.5-0.8b": {
        "reserveTokens": 20000
      },
      "llama.cpp/qwen3.5-2b": {
        "reserveTokens": 20000
      },
      "llama.cpp/sharp-minicpm5": {
        "reserveTokens": 20000
      },
      "llama.cpp/lfm2.5-24b": {
        "reserveTokens": 16384
      }
    }
  },
  "observational-memory": {
    "observerConcurrency": 1,
    "compactAtContextTokens": 64000,
    "compactAtContextRatio": 0.75,
    "models": {
      "observer": {
        "provider": "current",
        "id": "current",
        "thinking": "low"
      },
      "consolidator": {
        "provider": "current",
        "id": "current",
        "thinking": "medium"
      }
    }
  },
  "defaultProvider": "llama.cpp",
  "defaultModel": "qwen3.5-2b"
}