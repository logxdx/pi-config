{
  "lastChangelogVersion": "1.2.0",
  "terminal": {
    "showImages": false,
    "imageWidthCells": 60,
    "showTerminalProgress": true
  },
  "images": {
    "blockImages": true
  },
  "transport": "auto",
  "httpIdleTimeoutMs": 300000,
  "cacheWarming": "streaming",
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "enableInstallTelemetry": false,
  "tuiMode": "fullscreen",
  "theme": "dark",
  "packages": [
    "./packages/pi-interactive-subagents",
    "./packages/pi-observational-memory"
  ],
  "observational-memory": {
    "observerConcurrency": 1,
    "compactAtContextTokens": 64000,
    "models": {
      "observer": {
        "provider": "current",
        "id": "current",
        "thinking": "low"
      },
      "consolidator": {
        "provider": "current",
        "id": "current",
        "thinking": "medium"
      }
    }
  },
  "defaultProvider": "llama.cpp",
  "defaultModel": "qwen3.5-2b"
}