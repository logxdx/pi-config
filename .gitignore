# Credentials & machine-local state
agent/auth.json
agent/models-store.json
agent/trust.json
agent/*.bak*

# Sessions & runtime data
agent/sessions/
agent/rewind/
**/artifacts/

# Pi itself: launcher and release bundles written by the pi.dev installer
agent/bin/
agent/install/

# Package installs managed by pi, rebuilt from settings.json "packages"
agent/git/
agent/npm/

# Dependencies & build caches
node_modules/
.venv/
__pycache__/
*.pyc

# Claude Code worktrees
.claude/worktrees/
